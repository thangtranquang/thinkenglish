# Copy to .env (never commit .env). All values are optional; defaults shown.
APP_ORIGIN=http://localhost:8000
DATA_DIR=data
DB_PATH=data/reflex.db
# AI image analysis. Priority: LLM_* (OpenAI-compatible vision endpoint) > GEMINI_API_KEY > deterministic mock.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b
LLM_TIMEOUT_SECONDS=120
GEMINI_API_KEY=
SESSION_IDLE_SECONDS=1800
GUEST_FREE_SESSIONS=1
LOGIN_FAIL_PER_NICKNAME=5
LOGIN_FAIL_PER_IP=100
LOGIN_WINDOW_SECONDS=900
REGISTER_PER_IP=30
REGISTER_WINDOW_SECONDS=3600
GUEST_CREATE_PER_IP_PER_HOUR=60
MAX_UPLOAD_BYTES=5242880
MAX_PIXELS=25000000
PROCESSING_STALE_SECONDS=120
SCRYPT_N=16384
